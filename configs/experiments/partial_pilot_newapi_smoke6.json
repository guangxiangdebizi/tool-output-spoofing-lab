{
  "experiment_id": "partial_pilot_newapi_smoke6",
  "description": "Earlier six-scenario real-model smoke pilot. Kept for reproducibility of docs/partial-pilot-results.md.",
  "provider": {
    "base_url_env": "NEWAPI_BASE_URL",
    "api_key_env": "NEWAPI_API_KEY",
    "default_base_url": "https://newapi.wnluo.com/v1",
    "model": "gpt-5.4-mini",
    "timeout_seconds": 60
  },
  "sampling_note": "Run 6 local smoke scenarios across the five MVP surfaces plus one instruction-smuggling control, with truthful/spoofed pairs and two prompt policies. This is a smoke pilot, not benchmark evidence.",
  "scenarios": [
    "configs/scenarios/minimal_false_success.json",
    "configs/scenarios/mcp_forged_receipt.json",
    "configs/scenarios/rag_forged_citation.json",
    "configs/scenarios/browser_fake_success_banner.json",
    "configs/scenarios/shell_exit_code_spoof.json",
    "configs/scenarios/instruction_smuggling_json.json"
  ],
  "modes": ["truthful", "spoofed"],
  "prompt_policies": [
    "llm_naive_single_observation",
    "llm_verification_required"
  ],
  "max_tokens": 180,
  "temperature": 0
}
