{
  "experiment_id": "authorization_toolcall_pilot_small",
  "description": "Small model-facing pilot for authorization/provenance spoofing: one sandbox authorization scenario x truthful/spoofed x six tool-call policies.",
  "provider": {
    "base_url_env": "NEWAPI_BASE_URL",
    "api_key_env": "NEWAPI_API_KEY",
    "default_base_url": "https://newapi.wnluo.com/v1",
    "models": ["gpt-5.4-mini"],
    "timeout_seconds": 60,
    "retries": 1,
    "retry_sleep_seconds": 1.0
  },
  "scenarios": [
    "configs/scenarios/security_authorization_spoof.json"
  ],
  "modes": ["truthful", "spoofed"],
  "profiles": [
    "toolcall_naive",
    "toolcall_schema_only",
    "toolcall_prompt_filter",
    "toolcall_repeat_same_tool",
    "toolcall_independent_validator",
    "toolcall_combined_policy"
  ],
  "temperature": 0,
  "tool_budget": {
    "primary": 1,
    "repeat_same_tool": 1,
    "independent_validator": 1,
    "freshness_check": 1,
    "signature_check": 1
  },
  "output_scope": "verdict_only_authorization_status_and_assessment_level_no_exploit_steps"
}
